# サーバーだけが読みます。ブラウザのコードには書きません。
# 値を入れたファイルは .env という名前で置き、コミットしないでください。

# 本命の音声プロバイダ。openai 以外にするとブラウザ音声は始まりません。
VOICE_PROVIDER=openai

# https://platform.openai.com/api-keys で発行した秘密鍵。sk- で始まります。
OPENAI_API_KEY=

# 公式の Realtime モデル名。変わったらここだけ差し替えます。
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# 学習者の音声を字幕にするための別モデル。空のままでも既定値が使われます。
# gpt-4o-mini-transcribe と gpt-4o-transcribe は増分の delta を出します。
# whisper-1 の delta は全文なので、途中の字幕には向きません。
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 推奨は marin または cedar。
OPENAI_VOICE=marin

# 会話後のQ&A判定に使うテキストモデル。Chat Completions の構造化出力に対応するもの。
# 2026-10-28 時点のモデル一覧では gpt-5.4-mini が構造化出力に対応している。
OPENAI_JUDGE_MODEL=gpt-5.4-mini

# 語数から除くフィラー。カンマ区切り。空ならアプリ内の既定一覧を使う。
# FILLER_WORDS=um,uh,erm,えーと,えっと,あの,うーん

# 補助アダプタ。ブラウザの全二重音声はこのデモでは未接続です。
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# トークン発行サーバーの待受ポートとホスト。手元は 127.0.0.1。Cloud Run は HOST=0.0.0.0。
PORT=8787
# HOST=127.0.0.1

# STG の有料 API（/api/realtime/session と /api/feedback/*）は、この秘密で署名したセッショントークンが必須。
# 秘密が入っているとき、MOUTHY_CLIENT_TOKEN は見ない。本番 (NODE_ENV=production) で秘密が空なら、有料 API は 503。
# 手元で秘密が空、かつ NODE_ENV が production でないときだけ、下のクライアントトークン（空ならチェックしない）に戻る。
# 値は Secret Manager の mouthy-session-secret。ここには書かない。
# MOUTHY_SESSION_SECRET=
# MOUTHY_APPLE_AUDIENCE=com.mouthy.stg
# iOS の OAuth クライアント ID。秘密ではない。infra/google-client.json と同じ値。
# MOUTHY_GOOGLE_CLIENT_ID=
# MOUTHY_CLIENT_TOKEN=
