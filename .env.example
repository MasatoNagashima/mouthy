# サーバーだけが読みます。ブラウザのコードには書きません。
# 値を入れたファイルは .env という名前で置き、コミットしないでください。

# 本命の音声プロバイダ。openai 以外にするとブラウザ音声は始まりません。
VOICE_PROVIDER=openai

# https://platform.openai.com/api-keys で発行した秘密鍵。sk- で始まります。
OPENAI_API_KEY=

# 公式の Realtime モデル名。変わったらここだけ差し替えます。
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# 学習者の音声を文字にするための別モデル。空のままでも既定値が使われます。
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 推奨は marin または cedar。
OPENAI_VOICE=marin

# 補助アダプタ。ブラウザの全二重音声はこのデモでは未接続です。
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# トークン発行サーバーの待受ポート。
PORT=8787
