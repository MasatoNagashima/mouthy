// STG だけ。本番の xcconfig は置かない。
// Cloud Run の URL が決まったら、下の API_BASE_URL をその URL に変える。
// `http:/$()/` は xcconfig が // をコメントとみなさないようにするため。
API_BASE_URL = https:/$()/mouthy-api-svueiqi6pq-an.a.run.app
// 空なら、手元のサーバー（本番以外）はクライアントトークンを要求しない。
// STG の有料 API は Firebase の ID トークンが必須で、この値は見ない。
MOUTHY_CLIENT_TOKEN =
